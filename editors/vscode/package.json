{
  "name": "zamak",
  "displayName": "Zamak",
  "description": "Zamak language support: syntax highlighting, diagnostics as you type, completion, hover, go to definition, and formatting.",
  "version": "0.1.0",
  "publisher": "zamak",
  "author": "rayL-K",
  "license": "MIT OR Apache-2.0",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "keywords": [
    "zamak",
    "zam",
    "language",
    "grammar",
    "syntax",
    "lsp"
  ],
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/VeyraLux/Zamak.git",
    "directory": "editors/vscode"
  },
  "contributes": {
    "languages": [
      {
        "id": "zamak",
        "aliases": [
          "Zamak",
          "zam"
        ],
        "extensions": [
          ".zm"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "zamak",
        "scopeName": "source.zamak",
        "path": "./syntaxes/zamak.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Zamak",
      "properties": {
        "zamak.path": {
          "type": "string",
          "default": "zam",
          "markdownDescription": "Path to the `zam` command. The extension runs `zam lsp` for diagnostics, completion, hover, go to definition, and formatting."
        }
      }
    },
    "commands": [
      {
        "command": "zamak.restartServer",
        "title": "Zamak: Restart Language Server"
      }
    ]
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:zamak"
  ],
  "scripts": {
    "check": "node scripts/check-grammar.mjs"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
