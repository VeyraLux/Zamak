// 结构体和枚举的方法：&self 只读，&mut self 修改，self 移入；没有 self 的是关联函数，用类型名调用。
use std/math

struct Vec2:
    x: f64
    y: f64

    fn new(x: f64, y: f64) -> Vec2:
        Vec2(x: x, y: y)

    fn length(&self) -> f64:
        math.sqrt(self.x * self.x + self.y * self.y)

    fn scale(&mut self, k: f64):
        self.x *= k
        self.y *= k

    fn plus(self, other: &Vec2) -> Vec2:
        Vec2(x: self.x + other.x, y: self.y + other.y)

enum Shape:
    Circle(r: f64)
    Square(side: f64)

    fn area(&self) -> f64:
        match self:
            Circle(r): math.pi * r * r
            Square(side): side * side

    fn name(&self) -> string:
        match self:
            Circle(_): "circle"
            Square(_): "square"

struct Account:
    owner: string
    balance: i64

    fn withdraw(&mut self, amount: i64) -> !string:
        if amount > self.balance:
            fail "{self.owner} has only {self.balance}"

        self.balance -= amount

fn main() -> !string:
    let mut v = Vec2.new(3.0, 4.0)
    println(v.length())
    v.scale(2.0)
    println(v)
    let one = Vec2.new(1.0, 1.0)
    let w = v.plus(&one)
    println(w)
    println(Vec2.new(0.0, 2.0).length())

    let shapes: [Shape] = [Shape.Circle(1.0), Shape.Square(3.0)]

    for shape in &shapes:
        println("{shape.name()}: {fmt_area(shape.area())}")

    println(shapes[1].area())

    let mut account = Account(owner: "ada", balance: 100)
    account.withdraw(30)?
    println(account.balance)
    account.withdraw(500) catch e:
        println("refused: {e}")
        return
    println("unreachable")

fn fmt_area(a: f64) -> string:
    "{i64(math.round(a))}"
