# JSON：json.loads 读，json.dumps 写，接口照 Python。
# r"""...""" 是原始的三引号字符串：里面的双引号、反斜杠和花括号都原样保留。
use std/json

fn main() -> !string:
    let text = r"""{"name": "Ada", "langs": ["Zamak", "C"], "age": 36, "admin": false}"""
    let user = json.loads(text)?
    println(user.get("name")?.as_str()?)
    println(user.get("age")?.as_i64()? + 1)
    println(user.get("langs")?.item(0)?.as_str()?)
    println(user.keys())

    let mut fields: {string: json.Json} = {}
    fields["ok"] = json.Json.Bool(true)
    fields["count"] = json.Json.Number(3.0)
    fields["tags"] = json.Json.Array([json.Json.Str("a"), json.Json.Null])
    let reply = json.Json.Object(fields)
    println(json.dumps(reply))
    println(json.dumps(reply, indent=2))

    json.loads(r"""{"a": }""") catch e:
        println(e)
