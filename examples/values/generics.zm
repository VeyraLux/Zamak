# 泛型函数：fn name[T](...)，按调用时的实参类型生成专门的版本。

fn largest[T](items: &[T]) -> T:
    let mut best = items[0]

    for item in items:
        if item > best:
            best = item

    best

fn count_if[T](items: &[T], wanted: &T) -> i64:
    let mut count = 0

    for item in items:
        if item == wanted:
            count += 1

    count

fn swap_pair[A, B](pair: (A, B)) -> (B, A):
    let (a, b) = pair
    (b, a)

fn repeat[T](value: &T, times: i64) -> [T]:
    let mut out: [T] = []

    for i in 0..times:
        out.push(copy(value))

    out

fn main():
    let numbers: [i64] = [3, 9, 4]
    println(largest(&numbers))
    let prices: [f64] = [2.5, 1.5]
    println(largest(&prices))

    let words: [string] = ["b", "a", "b"]
    println(count_if(&words, "b"))
    println(count_if(&numbers, 4))

    println(swap_pair((1, "one")))
    println(repeat("ab", 3))
