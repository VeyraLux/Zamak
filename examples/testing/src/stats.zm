# 被测试的模块：测试函数和被测代码写在同一个文件里，名字以 test_ 开头。

pub fn mean(xs: &[f64]) -> f64!string:
    if xs.len() == 0:
        fail "mean of an empty list"

    let mut total = 0.0

    for x in xs:
        total += x

    total / f64(xs.len())

pub fn largest(xs: &[i64]) -> Option[i64]:
    if xs.len() == 0:
        return Option.None

    let mut best = xs[0]

    for x in xs:
        if x > best:
            best = x

    Option.Some(best)

fn test_mean() -> !string:
    let xs: [f64] = [1.0, 2.0, 3.0]
    assert mean(&xs)? == 2.0

fn test_mean_of_empty_list_fails():
    let xs: [f64] = []
    let value = mean(&xs) catch e:
        assert e == "mean of an empty list"
        return

    assert false, "mean should have failed, got {value}"

fn test_largest():
    let xs: [i64] = [3, 9, 4]
    assert largest(&xs) == Option.Some(9)
    let empty: [i64] = []
    let none: Option[i64] = Option.None
    assert largest(&empty) == none
