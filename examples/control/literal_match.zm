// match 按字面量分支（整数、字符、字符串、布尔，| 列出多个），以及在调用结果上接着调用方法。
use std/string

fn describe(n: i64) -> string:
    match n:
        0: "zero"
        1 | 2 | 3: "small"
        -1: "minus one"
        _: "many"

fn kind(c: i64) -> string:
    let label = match c:
        'a' | 'e' | 'i' | 'o' | 'u': "vowel"
        ' ': "space"
        _: "other"
    label

fn main():
    for n in -1..5:
        println("{n} is {describe(n)}")

    let words = string.words("apple banana kiwi")

    for word in &words:
        match word:
            "apple":
                println("red")
            "banana" | "mango":
                println("yellow")
            _:
                println("unknown fruit {word}")

    println(kind('e'))
    println(kind('x'))

    let ready = string.split("a,b,c", ",").len() == 3
    let answer = match ready:
        true: "yes"
        false: "no"
    println(answer)

    match string.trim("  stop  "):
        "go": println("going")
        "stop": println("stopping")

    let parts = string.split("x-y-z", "-").slice(1, 3)
    println(parts)
    println(string.words("one two three").slice(0, 2).len())
