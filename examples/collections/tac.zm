use std/env
use std/fs
use std/io
use std/string

// 倒序输出各行，并把每行的单词数写在前面；给了参数就读文件，否则读标准输入。
// 用法：zam run examples/collections/tac.zm -- <文件>
fn main() -> !string {
    let args = env.args()
    let mut text = ""
    if args.len() > 0 {
        text = fs.read(&args[0])?
    } else {
        text = io.read_all()?
    }
    let mut lines = string.lines(&text)
    let mut longest = ""
    while lines.len() > 0 {
        let line = lines.pop()
        let words = string.words(&line)
        let count = words.len()
        println("{count}: {line}")
        for word in &words {
            if string.byte_len(word) > string.byte_len(&longest) {
                // 循环变量是对列表元素的借用；要留下来就显式复制一份。
                longest = string.copy(word)
            }
        }
    }
    let space = " "
    let names: [string] = ["longest", "word:"]
    let label = string.join(&names, &space)
    println("{label} {longest}")
}
