# todo：命令行的待办事项。数据存在一个 JSON 文件里（默认 ~/.zamak-todo.json，可以用环境变量
# TODO_FILE 指定）。
#
#     todo add "write the report" --due 2026-11-01 --tag work
#     todo list
#     todo done 1
use std/cli
use std/datetime
use std/env
use std/fs
use std/json
use std/path

struct Task:
    id: i64
    text: string
    done: bool
    due: string
    tags: [string]

fn usage() -> string:
    """usage: todo add TEXT [--due YYYY-MM-DD] [--tag TAG]... | list [--all] [--tag TAG] | done ID | remove ID | edit ID TEXT"""

fn store() -> string:
    let chosen = env.var("TODO_FILE") catch e: ""

    if chosen != "":
        return chosen

    let home = env.var("HOME") catch e: env.var("USERPROFILE") catch e: "."
    path.join(home, ".zamak-todo.json")

# 子命令的选项：字段就是选项，std/cli 按类型读（--due 一个值，--tag 可以写几次，args 收其余的词）。
struct AddOptions:
    due: Option[string]
    tag: [string]
    args: [string]

struct ListOptions:
    all: bool
    tag: Option[string]

# 数据文件就是 {"tasks": [...]}：json.encode 与 json.decode 按 Store 的结构自动转换。
struct Store:
    tasks: [Task]

fn load(file: &string) -> [Task]!string:
    if not fs.exists(file):
        return []

    let store: Store = json.decode(fs.read(file)?)?
    store.tasks

fn save(file: &string, tasks: &[Task]) -> !string:
    fs.write(file, json.encode(Store(tasks: copy(tasks)), indent=2))?

fn find(tasks: &[Task], id: i64) -> i64!string:
    for i, t in tasks:
        if t.id == id:
            return i

    fail f"no task {id}"

fn show(t: &Task, today: &datetime.Date):
    let mark = if t.done: "x" else: " "
    let mut line = f"[{mark}] {t.id:>3}  {t.text}"

    if t.due != "":
        let due = datetime.date_from_iso(t.due) catch e: today
        let days = due.days_since(today)
        let when = if days < 0: f"overdue {-days}d" elif days == 0: "due today" else: f"due in {days}d"
        line += f"  ({t.due}, {when})"

    if len(t.tags) > 0:
        line += f"  #{" #".join(t.tags)}"

    println(line)

fn main() -> !string:
    let args = env.args()

    if len(args) == 0:
        fail usage()

    let file = store()
    let mut tasks = load(file)?
    let command = args[0]
    let today = datetime.today()

    if command == "add":
        let options: AddOptions = cli.parse(args[1:])?
        let text = " ".join(options.args)

        if text == "":
            fail usage()

        let due = match options.due:
            Some(day): datetime.date_from_iso(day)?.isoformat()
            None: ""

        let mut next = 1

        for t in &tasks:
            next = max(next, t.id + 1)

        tasks.push(Task(id: next, text: text, done: false, due: due, tags: options.tag))
        save(file, tasks)?
        println(f"added {next}")
    elif command == "list":
        let options: ListOptions = cli.parse(args[1:])?
        let tag = match options.tag:
            Some(name): copy(name)
            None: ""

        let mut shown = 0

        for t in &tasks:
            if (options.all or not t.done) and (tag == "" or tag in t.tags):
                show(t, today)
                shown += 1

        if shown == 0:
            println("nothing to do")
    elif command == "done" or command == "remove":
        if len(args) < 2:
            fail usage()

        let at = find(tasks, args[1].parse_i64()?)?

        if command == "done":
            tasks[at].done = true
        else:
            tasks.pop(at)

        save(file, tasks)?
        println(f"{command} {args[1]}")
    elif command == "edit":
        if len(args) < 3:
            fail usage()

        let at = find(tasks, args[1].parse_i64()?)?
        tasks[at].text = " ".join(args[2:])
        save(file, tasks)?
        println(f"edited {args[1]}")
    else:
        fail f"unknown command {command}\n{usage()}"
