use std/io

fn main() -> !string {
    let mut seen: {string: bool} = {}
    let mut removed = 0
    let mut line = ""
    while io.read_line(&mut line)? {
        if seen.contains(&line) {
            removed = removed + 1
        } else {
            seen[&line] = true
            println(line)
        }
    }
    println("removed {removed}")
}
