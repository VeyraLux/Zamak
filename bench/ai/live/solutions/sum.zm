use std/io
use std/string

fn main() -> !string {
    let mut line = ""
    let mut number = 0
    let mut total = 0
    while io.read_line(&mut line)? {
        number = number + 1
        let text = string.trim(&line)
        if string.byte_len(&text) == 0 {
            continue
        }
        let value = string.parse_i64(&text) catch e {
            fail "invalid line {number}"
        }
        total = total + value
    }
    println(total)
}
