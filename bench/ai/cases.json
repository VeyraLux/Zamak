  {
    "id": "catch-missing-import",
    "source": "fn load() -> i64!string {\n    fail \"nope\"\n}\nfn main() {\n    let value = load() catch e {\n        println(missing.call())\n        return\n    }\n    println(value)\n}\n",
    "expected_code": "ZM203",
    "expected_location": { "file": "main.zm", "line": 6, "column": 9 },
    "patches": [{ "find": "missing.call()", "replace": "7" }],
    "expected_output": "7\n"
  },
  {
    "id": "multi-module-nested-catch",
    "files": [
      { "path": "main.zm", "source": "use handler\nfn main() {\n    handler.run()\n}\n" },
      { "path": "handler.zm", "source": "fn load() -> i64!string {\n    fail \"nope\"\n}\npub fn run() {\n    let value = load() catch e {\n        let inner = load() catch nested {\n            println(missing.call())\n            return\n        }\n        return\n    }\n    println(value)\n}\n" }
    ],
    "expected_code": "ZM203",
    "expected_location": { "file": "src/handler.zm", "line": 7, "column": 13 },
    "patches": [{ "find": "missing.call()", "replace": "7" }],
    "expected_output": "7\n"
  },
