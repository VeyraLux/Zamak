  {
    "id": "array-bounds",
    "source": "fn main() {\n    let a = [1, 2, 3]\n    println(a[5])\n}\n",
    "expected_code": "ZM406",
    "patches": [
      { "find": "println(a[5])", "replace": "println(a[2])" }
