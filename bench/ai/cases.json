  {
    "id": "literal-overflow",
    "source": "fn main() {\n    let x = 9223372036854775808\n    println(x)\n}\n",
    "expected_code": "ZM600",
    "patches": [
      { "find": "9223372036854775808", "replace": "9223372036854775807" }
    ],
    "expected_output": "9223372036854775807\n"
  },
  {
    "id": "error-unhandled",
    "source": "fn parse(text: &string) -> i64!string {\n    return 42\n}\n\nfn main() {\n    let text = \"42\"\n    let value = parse(&text)\n    println(value)\n}\n",
    "expected_code": "ZM500",
    "patches": [
      { "find": "fn main() {", "replace": "fn main() -> !string {" },
      { "find": "let value = parse(&text)", "replace": "let value = parse(&text)?" }
    ],
    "expected_output": "42\n"
  },
  {
    "id": "error-type-not-string",
    "source": "fn parse() -> i64!i64 {\n    return 42\n}\n\nfn main() -> !i64 {\n    let value = parse()?\n    println(value)\n}\n",
    "expected_code": "ZM509",
    "patches": [
      { "find": "fn parse() -> i64!i64 {", "replace": "fn parse() -> i64!string {" },
      { "find": "fn main() -> !i64 {", "replace": "fn main() -> !string {" }
    ],
    "expected_output": "42\n"
  },
  {
    "id": "unknown-function",
    "source": "fn double(value: i64) -> i64 {\n    return value * 2\n}\n\nfn main() {\n    println(triple(21))\n}\n",
    "expected_code": "ZM201",
    "patches": [
      { "find": "println(triple(21))", "replace": "println(double(21))" }
    ],
    "expected_output": "42\n"
  },
  {
    "id": "unknown-struct-field",
    "source": "struct Point {\n    x: i64\n    y: i64\n}\n\nfn main() {\n    let p = Point {\n        x: 1\n        y: 2\n    }\n    println(p.z)\n}\n",
    "expected_code": "ZM202",
    "patches": [
      { "find": "println(p.z)", "replace": "println(p.x)" }
