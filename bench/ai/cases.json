    "expected_output": "1\n"
  },
  {
    "id": "borrow-conflict",
    "source": "fn combine(a: &string, b: &mut string) {\n    println(a)\n    b = \"changed\"\n}\n\nfn main() {\n    let mut message = \"hi\"\n    combine(&message, &mut message)\n}\n",
    "expected_code": "ZM421",
    "patches": [
      { "find": "let mut message = \"hi\"", "replace": "let message = \"hi\"\n    let mut other = \"second\"" },
      { "find": "combine(&message, &mut message)", "replace": "combine(&message, &mut other)" }
    ],
    "expected_output": "hi\n"
  },
  {
    "id": "borrow-immutable-mutable",
    "source": "fn update(text: &mut string) {\n    text = \"changed\"\n    println(text)\n}\n\nfn main() {\n    let message = \"hi\"\n    update(&mut message)\n}\n",
    "expected_code": "ZM424",
    "patches": [
      { "find": "let message = \"hi\"", "replace": "let mut message = \"hi\"" }
    ],
    "expected_output": "changed\n"
  },
  {
    "id": "borrow-type-mismatch",
    "source": "fn show(text: &string) {\n    println(text)\n}\n\nfn main() {\n    let mut message = \"hi\"\n    show(&mut message)\n}\n",
    "expected_code": "ZM423",
    "patches": [
      { "find": "show(&mut message)", "replace": "show(&message)" }
    ],
    "expected_output": "hi\n"
  },
  {
    "id": "borrow-escape",
    "source": "fn main() {\n    let message = \"hi\"\n    let stored = &message\n    println(stored)\n}\n",
    "expected_code": "ZM422",
    "patches": [
      { "find": "let stored = &message", "replace": "let stored = message" }
    ],
    "expected_output": "hi\n"
  },
  {
    "id": "multi-module-valid",
    "files": [
      { "path": "main.zm", "source": "use greeting\nuse std/io\n\nfn main() {\n    greeting.hello()\n    io.println(\"main done\")\n}\n" },
      { "path": "greeting.zm", "source": "pub fn hello() {\n    println(\"hello from zamak\")\n}\n" }
    ],
    "expected_code": null,
    "patches": [],
    "expected_output": "hello from zamak\nmain done\n"
  },
  {
    "expected_location": { "file": "src/main.zm", "line": 5, "column": 5 },
    "id": "multi-module-borrow",
    "files": [
      { "path": "main.zm", "source": "use greeting\n\nfn main() {\n    let message: string = \"hi\"\n    greeting.show(message)\n}\n" },
      { "path": "greeting.zm", "source": "pub fn show(text: &string) {\n    println(text)\n}\n" }
    ],
    "expected_code": "ZM425",
    "patches": [
      { "find": "greeting.show(message)", "replace": "greeting.show(&message)" }
    ],
    "expected_output": "hi\n"
  },
