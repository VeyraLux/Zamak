[
  {
    "id": "valid-control",
    "source": "fn main() {\n    println(7)\n}\n",
    "expected_code": null,
    "patches": [],
    "expected_output": "7\n"
  },
  {
    "id": "syntax-character",
    "source": "fn main() {\n    println(@)\n}\n",
    "expected_code": "ZM100",
    "patches": [
      { "find": "println(@)", "replace": "println(1)" }
    ],
    "expected_output": "1\n"
  },
  {
    "id": "ownership-move",
    "source": "fn main() {\n    let a = \"x\"\n    let b = a\n    println(a)\n}\n",
    "expected_code": "ZM301",
    "patches": [
      { "find": "println(a)", "replace": "println(b)" }
    ],
    "expected_output": "x\n"
  },
  {
    "id": "missing-return",
    "source": "fn value() -> string {}\nfn main() { println(value()) }\n",
    "expected_code": "ZM510",
    "patches": [
      { "find": "fn value() -> string {}", "replace": "fn value() -> string {\n    return \"ok\"\n}" }
    ],
    "expected_output": "ok\n"
  },
  {
    "id": "type-mismatch",
    "source": "fn main() {\n    let x: i64 = \"s\"\n}\n",
    "expected_code": "ZM200",
    "patches": [
      { "find": "let x: i64 = \"s\"", "replace": "let x: i64 = 1" }
    ],
    "expected_output": ""
  },
  {
    "id": "immutable-assign",
    "source": "fn main() {\n    let count = 1\n    count = 2\n    println(count)\n}\n",
    "expected_code": "ZM302",
    "patches": [
      { "find": "let count = 1", "replace": "let mut count = 1" }
    ],
    "expected_output": "2\n"
  },
  {
    "id": "borrow-missing-ampersand",
