# TCP 网络：连接、监听、收发字节。形状参考 Python 的 socket 模块，但用起来更直接：
# net.connect 得到连接，net.listen 得到监听器，连接与监听器离开作用域时自动关闭。
# conn.start_tls(host) 在连接上开启 TLS（客户端，校验证书），listener.accept_tls(...) 接受 TLS 连接。
use std/bytes

extern type Socket: "void", close = zam_net_close

# 句柄写进输出参数：match 拿到的是借用，从 Option 里取不出来，直接写进结构体的字段。
extern fn zam_net_connect(host: &string, port: i64, timeout: f64, out: &mut Option[Socket]) -> i64
extern fn zam_net_listen(host: &string, port: i64, out: &mut Option[Socket]) -> i64
extern fn zam_net_accept(listener: &Socket, out: &mut Option[Socket]) -> i64
extern fn zam_net_port(listener: &Socket) -> i64
extern fn zam_net_send(conn: &Socket, data: &bytes, n: i64) -> i64
extern fn zam_net_recv(conn: &Socket, buf: &mut bytes, n: i64) -> i64
extern fn zam_net_timeout(conn: &Socket, seconds: f64)
extern fn zam_net_error() -> string

extern type Tls: "void", close = zam_tls_free

extern fn zam_tls_connect(socket: &Socket, host: &string, out: &mut Option[Tls]) -> i64
extern fn zam_tls_accept(socket: &Socket, cert_file: &string, key_file: &string, out: &mut Option[Tls]) -> i64
extern fn zam_tls_send(tls: &Tls, data: &bytes, n: i64) -> i64
extern fn zam_tls_recv(tls: &Tls, buf: &mut bytes, n: i64) -> i64
extern fn zam_tls_error() -> string

# 一条 TCP 连接。
pub struct Conn:
    # TLS 写在套接字前面：释放时先发 close_notify，再关套接字。
    tls: Option[Tls]
    socket: Option[Socket]

    # 在这条连接上开启 TLS（客户端）：校验服务器证书，host 用来核对证书上的名字。
    pub fn start_tls(&mut self, host: &string) -> !string:
        let mut tls: Option[Tls] = Option.None

        match self.socket:
            Some(s):
                if zam_tls_connect(s, host, &mut tls) < 0:
                    fail f"cannot start TLS with {host}: {zam_tls_error()}"
            None: fail "the connection is closed"

        self.tls = tls

    # 在接受下来的连接上完成 TLS 握手（服务端）：cert_file 是 PEM 格式的证书链，key_file 是私钥。
    pub fn accept_tls(&mut self, cert_file: &string, key_file: &string) -> !string:
        let mut tls: Option[Tls] = Option.None

        match self.socket:
            Some(s):
                if zam_tls_accept(s, cert_file, key_file, &mut tls) < 0:
                    fail zam_tls_error()
            None: fail "the connection is closed"

        self.tls = tls

    # 把 data 全部发出去。
    pub fn send(&self, data: &bytes) -> !string:
        match self.tls:
            Some(t):
                if zam_tls_send(t, data, len(data)) < 0:
                    fail zam_tls_error()

                return
            None: pass

        match self.socket:
            Some(s):
                if zam_net_send(s, data, len(data)) < 0:
                    fail zam_net_error()
            None: fail "the connection is closed"

    # 收一次数据，最多 max 个字节。对方关闭连接时得到空的 bytes。
    pub fn recv(&self, max: i64 = 65536) -> bytes!string:
        match self.tls:
            Some(t):
                let mut secret = bytes.zeros(max)
                let got = zam_tls_recv(t, &mut secret, max)

                if got < 0:
                    fail zam_tls_error()

                return secret[:got]
            None: pass

        match self.socket:
            Some(s):
                let mut buf = bytes.zeros(max)
                let n = zam_net_recv(s, &mut buf, max)

                if n < 0:
                    fail zam_net_error()

                return buf[:n]
            None: fail "the connection is closed"

    # 一直收到对方关闭连接为止。
    pub fn recv_all(&self) -> bytes!string:
        let mut out: bytes = []

        while true:
            let chunk = self.recv()?

            if len(chunk) == 0:
                break

            out.extend(chunk)

        out

    # 收发的超时，单位秒；0 表示一直等。
    pub fn set_timeout(&self, seconds: f64):
        match self.socket:
            Some(s): zam_net_timeout(s, seconds)
            None: pass

    pub fn close(&mut self):
        self.tls = Option.None
        self.socket = Option.None

# 监听某个地址的 TCP 连接。
pub struct Listener:
    socket: Option[Socket]

    # 等下一条连接。
    pub fn accept(&self) -> Conn!string:
        let mut conn = Conn(tls=Option.None, socket=Option.None)

        match self.socket:
            Some(s):
                if zam_net_accept(s, &mut conn.socket) < 0:
                    fail zam_net_error()
            None: fail "the listener is closed"

        conn

    # 等下一条连接，并用 cert_file（PEM 格式的证书链）与 key_file（私钥）完成 TLS 握手。
    pub fn accept_tls(&self, cert_file: &string, key_file: &string) -> Conn!string:
        let mut conn = self.accept()?
        conn.accept_tls(cert_file, key_file)?
        conn

    # 实际监听的端口（监听 0 号端口时由系统挑选）。
    pub fn port(&self) -> i64:
        match self.socket:
            Some(s): zam_net_port(s)
            None: -1

    pub fn close(&mut self):
        self.socket = Option.None

# 连接到 host 的 port 端口。timeout 秒内连不上或收发停住时返回错误。
pub fn connect(host: &string, port: i64, timeout: f64 = 30.0) -> Conn!string:
    let mut conn = Conn(tls=Option.None, socket=Option.None)

    if zam_net_connect(host, port, timeout, &mut conn.socket) < 0:
        fail f"cannot connect to {host}:{port}: {zam_net_error()}"

    conn

# 在 host 的 port 端口上监听。host 写 "0.0.0.0" 接受所有网卡的连接，写 "127.0.0.1" 只接受本机的；
# port 写 0 由系统挑一个空闲端口，用 listener.port() 查。
pub fn listen(host: &string, port: i64) -> Listener!string:
    let mut listener = Listener(socket=Option.None)

    if zam_net_listen(host, port, &mut listener.socket) < 0:
        fail f"cannot listen on {host}:{port}: {zam_net_error()}"

    listener
