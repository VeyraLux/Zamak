# HTTP/1.1 客户端与服务端。客户端的形状参考 Python 的 requests：http.get(url)、http.post(url, body)，
# 响应有 status、headers、text()、json()。服务端：http.serve(host, port, handler)，几个线程同时处理请求。
# https:// 用 TLS，校验服务器证书（根证书来自系统，或环境变量 SSL_CERT_FILE 指定的文件）。
use std/net
use std/json
use std/thread

# 服务器返回的响应。headers 的键都是小写。
pub struct Response:
    status: i64
    reason: string
    headers: {string: string}
    body: bytes

    # 响应体按 UTF-8 解码成文字。
    pub fn text(&self) -> string!string:
        self.body.decode()?

    # 响应体按 JSON 解析。
    pub fn json(&self) -> json.Json!string:
        json.loads(self.body.decode()?)?

    # 状态码是 2xx。
    pub fn ok(&self) -> bool:
        self.status >= 200 and self.status < 300

# 服务端收到的请求。path 不含查询串，query 是 ? 后面的部分；headers 的键都是小写。
pub struct Request:
    method: string
    path: string
    query: string
    headers: {string: string}
    body: bytes

    pub fn text(&self) -> string!string:
        self.body.decode()?

    pub fn json(&self) -> json.Json!string:
        json.loads(self.body.decode()?)?

    # 查询串里的参数（`?q=milk&page=2`），值已经解码（%xx 与 +）。同名参数取最后一个。
    pub fn args(&self) -> {string: string}!string:
        parse_query(self.query)?

    # 查询串里名为 name 的参数；没有时是 default。
    pub fn arg(&self, name: &string, default: &string = "") -> string!string:
        let all = self.args()?

        if name in all:
            return copy(&all[name])

        copy(default)

# 发一个 GET 请求。
# follow 为 true（默认）时跟随重定向（301、302、303、307、308，最多 10 次），与 requests 相同。
# params 是查询参数（编码后接在 URL 的 ? 后面），headers 是额外的请求头，同 requests 的写法：
# http.get(url, params={"q": "zamak"}, headers={"Accept": "application/json"})。
pub fn get(url: &string, timeout: f64 = 30.0, follow: bool = true, params: &{string: string} = {}, headers: &{string: string} = {}) -> Response!string:
    request("GET", with_params(url, params), b"", headers, timeout, follow)?

# 发一个 POST 请求，body 是文字。
pub fn post(url: &string, body: &string, content_type: &string = "text/plain; charset=utf-8", timeout: f64 = 30.0, follow: bool = true, params: &{string: string} = {}, headers: &{string: string} = {}) -> Response!string:
    let mut all = copy(headers)
    all["Content-Type"] = copy(content_type)
    request("POST", with_params(url, params), body.encode(), all, timeout, follow)?

# 把 value 写成 JSON（Json，或结构体、列表等任何值），用 POST 发出去。
pub fn post_json[T](url: &string, value: &T, timeout: f64 = 30.0, follow: bool = true, params: &{string: string} = {}, headers: &{string: string} = {}) -> Response!string:
    let mut all = copy(headers)
    all["Content-Type"] = "application/json"
    request("POST", with_params(url, params), json.encode(value).encode(), all, timeout, follow)?

# 查询参数编码后接在 URL 后面：已经有 ? 时用 & 接上。
fn with_params(url: &string, params: &{string: string}) -> string:
    if len(params) == 0:
        return copy(url)

    let mut pairs: [string] = []

    for key, value in params:
        pairs.append(f"{quote(key, safe="")}={quote(value, safe="")}")

    let joiner = if "?" in url: "&" else: "?"
    f"{url}{joiner}{"&".join(pairs)}"

# 任意方法的请求。headers 里的项原样加进请求头。follow 为 true（默认）时跟随重定向：
# 303，以及 POST 遇到 301、302 时改用 GET 并不再发请求体；307、308 原样重发。最多跳 10 次。
pub fn request(method: &string, url: &string, body: &bytes, headers: &{string: string}, timeout: f64 = 30.0, follow: bool = true) -> Response!string:
    let mut current = copy(url)
    let mut get_now = false
    let empty: bytes = b""
    let mut hops = 0

    while true:
        let r = if get_now: send("GET", current, empty, headers, timeout)? else: send(method, current, body, headers, timeout)?

        if not follow or not redirect(r.status):
            return r

        let location = r.headers.get("location", "")

        if location == "":
            return r

        hops += 1

        if hops > 10:
            fail f"too many redirects starting at {url}"

        if r.status == 303 or ((r.status == 301 or r.status == 302) and method != "GET" and method != "HEAD"):
            get_now = true

        current = urljoin(current, location)

    fail "unreachable"

fn redirect(status: i64) -> bool:
    status == 301 or status == 302 or status == 303 or status == 307 or status == 308

# 把 link 按 base 补全成完整地址，与 Python 的 urllib.parse.urljoin 相同：
# 完整地址原样返回，//host 换协议，/path 换路径，?query 换查询，其他按目录补全并处理 . 与 ..。
pub fn urljoin(base: &string, link: &string) -> string:
    if link.find("://") > 0 and link.find("://") < 10:
        return copy(link)

    let scheme_end = base.find("://")

    if scheme_end < 0:
        return copy(link)

    if link.starts_with("//"):
        return f"{base[:scheme_end]}:{link}"

    let host_end = base.find("/", scheme_end + 3)
    let origin = if host_end < 0: copy(base) else: base[:host_end]
    let mut path = if host_end < 0: "/" else: base[host_end:]
    let query = path.find("?")

    if query >= 0:
        path = path[:query]

    let fragment = path.find("#")

    if fragment >= 0:
        path = path[:fragment]

    if link == "":
        return copy(base)

    if link.starts_with("?"):
        return f"{origin}{path}{link}"

    if link.starts_with("#"):
        let whole = base.find("#")
        let unmarked = if whole < 0: copy(base) else: base[:whole]
        return f"{unmarked}{link}"

    let folder_end = path.rfind("/") + 1
    let folder = path[:folder_end]
    let joined = if link.starts_with("/"): copy(link) else: f"{folder}{link}"
    f"{origin}{clean_path(joined)}"

# 去掉路径里的 . 与 ..（.. 不越过根）。查询与片段原样保留。
fn clean_path(full: &string) -> string:
    let mut path = copy(full)
    let mut rest = ""
    let cut = path.find("?")

    if cut >= 0:
        rest = path[cut:]
        path = path[:cut]

    let mut parts: [string] = []

    for part in path.split("/"):
        if part == "..":
            if len(parts) > 1:
                parts.pop()
        elif part != ".":
            parts.push(copy(part))

    let tail = path.ends_with("/.") or path.ends_with("/..")
    let mut cleaned = "/".join(parts)

    if tail:
        cleaned += "/"

    if not cleaned.starts_with("/"):
        cleaned = f"/{cleaned}"

    f"{cleaned}{rest}"

# 发一次请求，不跟随重定向。
fn send(method: &string, url: &string, body: &bytes, headers: &{string: string}, timeout: f64) -> Response!string:
    let target = parse_url(url)?
    let mut conn = net.connect(target.host, target.port, timeout)?

    if target.secure:
        conn.start_tls(target.host)?

    let mut head: [string] = [f"{method} {target.path} HTTP/1.1", f"Host: {target.host_header}", "Connection: close", "User-Agent: zamak", "Accept-Encoding: identity"]

    if len(body) > 0 or method == "POST" or method == "PUT" or method == "PATCH":
        head.push(f"Content-Length: {len(body)}")

    for key, value in headers:
        head.push(f"{key}: {value}")

    conn.send(("\r\n".join(head) + "\r\n\r\n").encode())?

    if len(body) > 0:
        conn.send(body)?

    parse_response(conn.recv_all()?)?

# 在 host 的 port 端口上一直处理请求：每个请求交给 handler，把它返回的响应发回去。
# workers 个线程同时处理请求（0 表示按处理器个数决定，至少 8 个），所以一个慢请求不会挡住别的请求；
# handler 在这些线程里运行，同一时间可能有几个在跑。给出 cert_file 与 key_file（PEM 文件）时用 HTTPS。
pub fn serve(host: &string, port: i64, handler: kept fn(&Request) -> Response, cert_file: &string = "", key_file: &string = "", workers: i64 = 0) -> !string:
    let listener = net.listen(host, port)?
    let count = if workers > 0: workers else: max(8, thread.cpu_count() * 2)
    let jobs: thread.Queue[net.Conn] = thread.queue()
    let mut pool: [thread.Thread] = []

    for _ in range(count):
        pool.append(thread.spawn(work, jobs.clone(), handler, copy(cert_file), copy(key_file)))

    while true:
        let conn = listener.accept() catch e: continue
        jobs.put(conn)?

# 工作线程：从队列里取连接，握手（HTTPS 时）后处理一个请求。出错的连接直接关掉。
fn work(jobs: thread.Queue[net.Conn], handler: kept fn(&Request) -> Response, cert_file: string, key_file: string):
    while true:
        match jobs.get():
            Some(conn):
                if cert_file != "":
                    conn.accept_tls(cert_file, key_file) catch e: continue

                answer(conn, handler) catch e: continue
            None: break

# 接受一条连接、处理一个请求，在当前线程里。测试或自己控制循环时用。
pub fn serve_one(listener: &net.Listener, handler: fn(&Request) -> Response, cert_file: &string = "", key_file: &string = "") -> !string:
    let conn = if cert_file == "": listener.accept()? else: listener.accept_tls(cert_file, key_file)?
    answer(conn, handler)?

# 在一条连接上读一个请求、交给 handler、把响应发回去。
fn answer(conn: &net.Conn, handler: fn(&Request) -> Response) -> !string:
    conn.set_timeout(30.0)
    let mut raw: bytes = []
    let mut end = -1

    while end < 0:
        let chunk = conn.recv()?

        if len(chunk) == 0:
            fail "the client closed the connection before sending a request"

        raw.extend(chunk)
        end = find_blank_line(raw)

    let head = raw[:end].decode()?
    let lines = head.split("\r\n")
    let first = lines[0].split(" ")

    if len(first) < 3:
        fail "malformed request line"

    let headers = parse_headers(lines)
    let mut body = raw[end + 4:]
    let wanted = if "content-length" in headers: int(headers["content-length"])? else: 0

    while len(body) < wanted:
        let chunk = conn.recv()?

        if len(chunk) == 0:
            break

        body.extend(chunk)

    let full = copy(&first[1])
    let mark = full.find("?")
    let path = if mark < 0: copy(&full) else: full[:mark]
    let query = if mark < 0: "" else: full[mark + 1:]
    let req = Request(method=copy(&first[0]), path=path, query=query, headers=headers, body=body)
    let response = handler(req)
    let mut out: [string] = [f"HTTP/1.1 {response.status} {response.reason}", f"Content-Length: {len(response.body)}", "Connection: close"]

    for key, value in response.headers:
        out.push(f"{key}: {value}")

    conn.send(("\r\n".join(out) + "\r\n\r\n").encode())?
    conn.send(response.body)?

# 文字响应。
pub fn respond(status: i64, body: &string, content_type: &string = "text/plain; charset=utf-8") -> Response:
    let mut headers: {string: string} = {}
    headers["content-type"] = content_type
    Response(status=status, reason=reason(status), headers=headers, body=body.encode())

# JSON 响应：value 可以是 Json，也可以是结构体、列表等任何能写成 JSON 的值。
pub fn respond_json[T](status: i64, value: &T) -> Response:
    respond(status, json.encode(value), content_type="application/json")

# 查询串变成参数字典（同 Python 的 urllib.parse.parse_qs，但每个名字只留最后一个值）。
pub fn parse_query(query: &string) -> {string: string}!string:
    let mut out: {string: string} = {}

    for pair in query.split("&"):
        if pair == "":
            continue

        let eq = pair.find("=")

        if eq < 0:
            out[unquote(pair, plus=true)?] = ""
        else:
            out[unquote(pair[:eq], plus=true)?] = unquote(pair[eq + 1:], plus=true)?

    out

# 把 %xx 换回原来的字节（同 Python 的 urllib.parse.unquote）；plus 为 true 时 + 也换成空格
# （查询串的写法，同 unquote_plus）。%xx 后面不是两个十六进制数字时原样保留。
# 换回来的字节不是 UTF-8 时返回错误。
pub fn unquote(text: &string, plus: bool = false) -> string!string:
    let raw = text.encode()
    let mut out: bytes = []
    let mut i = 0

    while i < len(raw):
        let c = raw[i]

        if c == '%' and i + 2 < len(raw) and hex_digit(raw[i + 1]) >= 0 and hex_digit(raw[i + 2]) >= 0:
            out.push(hex_digit(raw[i + 1]) * 16 + hex_digit(raw[i + 2]))
            i += 3
        elif c == '+' and plus:
            out.push(' ')
            i += 1
        else:
            out.push(c)
            i += 1

    out.decode() catch e: fail f"the decoded text of {text} is not valid UTF-8"

# 把文字写成能放进 URL 的样子（同 Python 的 urllib.parse.quote）：字母、数字和 _.-~ 以及 safe
# 里的字符原样保留，其余字节写成 %XX。
pub fn quote(text: &string, safe: &string = "/") -> string:
    let keep = safe.encode()
    let digits = b"0123456789ABCDEF"
    let mut out: bytes = []

    for c in text.encode():
        if (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_' or c == '.' or c == '-' or c == '~' or keep.contains(c):
            out.push(c)
        else:
            out.push('%')
            out.push(digits[c // 16])
            out.push(digits[c % 16])

    out.decode() catch e: ""

fn hex_digit(c: i64) -> i64:
    if c >= '0' and c <= '9':
        return c - '0'

    if c >= 'a' and c <= 'f':
        return c - 'a' + 10

    if c >= 'A' and c <= 'F':
        return c - 'A' + 10

    -1

struct Target:
    secure: bool
    host: string
    host_header: string
    port: i64
    path: string

fn parse_url(url: &string) -> Target!string:
    let mut rest = ""
    let mut port = 80
    let mut secure = false

    if url.starts_with("https://"):
        rest = url[8:]
        port = 443
        secure = true
    elif url.starts_with("http://"):
        rest = url[7:]
    else:
        fail f"a URL starts with http:// or https://, such as https://example.com/path; got {url}"

    let slash = rest.find("/")
    let question = rest.find("?")
    let cut = if slash < 0: question elif question < 0: slash else: min(slash, question)
    let authority = if cut < 0: copy(&rest) else: rest[:cut]
    let mut path = if cut < 0: "/" else: rest[cut:]

    if path.starts_with("?"):
        path = "/" + path

    let mut host = copy(&authority)

    if authority.starts_with("["):
        # IPv6：[::1]:8080
        let close = authority.find("]")

        if close < 0:
            fail f"malformed IPv6 address in {url}"

        host = authority[1:close]

        if authority[close + 1:].starts_with(":"):
            port = int(authority[close + 2:])?
    else:
        let colon = authority.find(":")

        if colon >= 0:
            host = authority[:colon]
            port = int(authority[colon + 1:])?

    if host == "":
        fail f"the URL has no host: {url}"

    Target(secure=secure, host=host, host_header=authority, port=port, path=path)

# 头部结束的位置（\r\n\r\n 的开头）；还没收到时是 -1。
fn find_blank_line(data: &bytes) -> i64:
    for i in range(len(data) - 3):
        if data[i] == 13 and data[i + 1] == 10 and data[i + 2] == 13 and data[i + 3] == 10:
            return i

    -1

fn parse_headers(lines: &[string]) -> {string: string}:
    let mut headers: {string: string} = {}

    for i in range(1, len(lines)):
        let line = &lines[i]
        let colon = line.find(":")

        if colon <= 0:
            continue

        let key = line[:colon].trim().lower()
        let value = line[colon + 1:].trim()

        if key in headers:
            headers[key] = headers[key] + ", " + value
        else:
            headers[key] = value

    headers

fn parse_response(raw: bytes) -> Response!string:
    let end = find_blank_line(raw)

    if end < 0:
        fail "malformed HTTP response: no blank line after the headers"

    let head = raw[:end].decode()?
    let lines = head.split("\r\n")
    let first = lines[0].split(" ")

    if len(first) < 2 or not first[0].starts_with("HTTP/"):
        fail f"malformed HTTP status line: {lines[0]}"

    let status = int(first[1])?
    let reason = " ".join(first[2:])
    let headers = parse_headers(lines)
    let mut body = raw[end + 4:]

    let encoding = headers.get("transfer-encoding", "").lower()

    if encoding.contains("chunked"):
        body = unchunk(body)?
    elif "content-length" in headers:
        let size = int(headers["content-length"])?

        if size < len(body):
            body = body[:size]

    Response(status=status, reason=reason, headers=headers, body=body)

# chunked 传输编码：每块是“十六进制长度\r\n数据\r\n”，长度为 0 的块结束。
fn unchunk(data: bytes) -> bytes!string:
    let mut out: bytes = []
    let mut at = 0

    while at < len(data):
        let mut line_end = at

        while line_end + 1 < len(data) and not (data[line_end] == 13 and data[line_end + 1] == 10):
            line_end += 1

        let parts = data[at:line_end].decode()?.split(";")
        let size_text = parts[0].trim()
        let size = hex_number(size_text)?

        if size == 0:
            break

        at = line_end + 2
        out.extend(data[at:at + size])
        at += size + 2

    out

fn hex_number(text: &string) -> i64!string:
    if text == "":
        fail "malformed chunk size in the HTTP response"

    let mut value = 0

    for c in text.lower().encode():
        let digit = if c >= '0' and c <= '9': c - '0' elif c >= 'a' and c <= 'f': c - 'a' + 10 else: -1

        if digit < 0:
            fail f"malformed chunk size {text} in the HTTP response"

        value = value * 16 + digit

    value

fn reason(status: i64) -> string:
    match status:
        200: "OK"
        201: "Created"
        204: "No Content"
        301: "Moved Permanently"
        302: "Found"
        304: "Not Modified"
        400: "Bad Request"
        401: "Unauthorized"
        403: "Forbidden"
        404: "Not Found"
        405: "Method Not Allowed"
        500: "Internal Server Error"
        _: "Status"
