# 窗口程序：原生控件（Windows、macOS、Linux 各用系统自己的），底层是 libui-ng。
#
#     struct Counter:
#         count: i64
#         label: ui.Label
#
#     fn clicked(app: &mut Counter):
#         app.count += 1
#         app.label.set_text(f"clicked {app.count} times")
#
#     fn main():
#         let window = ui.window("Counter", 320, 200)
#         let label = ui.label("not clicked yet")
#         let button = ui.button("Click me")
#         let column = ui.column()
#         column.add(label)
#         column.add(button)
#         window.set_child(column)
#         let app: ui.App[Counter] = ui.app()
#         app.on_click(button, clicked)
#         app.run(window, Counter(count: 0, label: label))
#
# 控件用小写的函数创建（ui.window、ui.button……），得到的值是指向控件的句柄：控件归父容器所有，
# 窗口关闭时一起销毁。ui.app() 得到的程序先登记回调，run 时交给它程序状态；回调是具名函数
# （或不用局部变量的匿名函数），收到 &mut 状态。界面只能在主线程里用。

