# 回调的种类，与 C 部分的枚举一致。
const CLICK = 0
const TEXT = 1
const TEXT_AREA = 2
const TOGGLE = 3
const SLIDE = 4
const SPIN = 5
const CHOOSE = 6
const RADIO = 7
const TIMER = 8
const CLOSE = 9
const SELECT = 10
const DRAW = 11
const MOUSE = 12
const KEY = 13

# 所有控件：能放进窗口与容器。
pub interface Control:
    fn handle(&self) -> i64

# 内容会变化、能用 app.on_change 接收变化的控件。
pub interface Changing:
    fn handle(&self) -> i64
    fn change_kind(&self) -> i64

# ---- 窗口 ----

pub struct Window:
    id: i64

    pub fn handle(&self) -> i64:
        self.id

    # 窗口的内容：一个控件，通常是 column、row、grid 之类的容器。
    pub fn set_child[C: Control](&self, child: &C):
        zam_ui_window_set_child(self.id, child.handle())

    pub fn set_title(&self, title: &string):
        zam_ui_window_set_title(self.id, title)

    pub fn title(&self) -> string:
        zam_ui_window_title(self.id)

    # 内容四周留出边距（默认留）。
    pub fn set_margined(&self, on: bool):
        zam_ui_window_set_margined(self.id, on)

    pub fn set_size(&self, width: i64, height: i64):
        zam_ui_window_set_size(self.id, width, height)

    # 弹出消息框，等用户关掉。
    pub fn message(&self, title: &string, text: &string):
        zam_ui_message(self.id, title, text, false)

    # 弹出错误消息框。
    pub fn error(&self, title: &string, text: &string):
        zam_ui_message(self.id, title, text, true)

    # 选择要打开的文件；用户取消时返回 None。
    pub fn open_file(&self) -> Option[string]:
        picked(zam_ui_pick(self.id, 0))

    # 选择保存到哪个文件；用户取消时返回 None。
    pub fn save_file(&self) -> Option[string]:
        picked(zam_ui_pick(self.id, 1))

    # 选择一个文件夹；用户取消时返回 None。
    pub fn open_folder(&self) -> Option[string]:
        picked(zam_ui_pick(self.id, 2))

fn picked(path: string) -> Option[string]:
    if path == "":
        return Option.None

    Option.Some(path)

# 新窗口：标题与内容区的宽、高（像素）。
pub fn window(title: &string, width: i64, height: i64) -> Window:
    let w = Window(id: zam_ui_window(title, width, height, false))
    w.set_margined(true)
    w

# ---- 布局 ----

# 从上到下排列控件。
pub struct Column:
    id: i64

    pub fn handle(&self) -> i64:
        self.id

    # 加一个控件；stretchy 为 true 时它分走多余的空间。
    pub fn add[C: Control](&self, child: &C, stretchy: bool = false):
        zam_ui_box_add(self.id, child.handle(), stretchy)

    pub fn set_padded(&self, on: bool):
        zam_ui_box_set_padded(self.id, on)

pub fn column() -> Column:
    let c = Column(id: zam_ui_box(true))
    c.set_padded(true)
    c

# 从左到右排列控件。
pub struct Row:
    id: i64

    pub fn handle(&self) -> i64:
        self.id

    # 加一个控件；stretchy 为 true 时它分走多余的空间。
    pub fn add[C: Control](&self, child: &C, stretchy: bool = false):
        zam_ui_box_add(self.id, child.handle(), stretchy)

    pub fn set_padded(&self, on: bool):
        zam_ui_box_set_padded(self.id, on)

pub fn row() -> Row:
    let r = Row(id: zam_ui_box(false))
    r.set_padded(true)
    r

# 带标题的框，里面放一个控件。
pub struct Group:
    id: i64

    pub fn handle(&self) -> i64:
        self.id

    pub fn set_child[C: Control](&self, child: &C):
        zam_ui_group_set_child(self.id, child.handle())

pub fn group(title: &string) -> Group:
    let g = Group(id: zam_ui_group(title))
    zam_ui_group_set_margined(g.id, true)
    g

# 选项卡：每页一个控件。
pub struct Tabs:
    id: i64

    pub fn handle(&self) -> i64:
        self.id

    pub fn add[C: Control](&self, name: &string, child: &C):
        zam_ui_tabs_add(self.id, name, child.handle())

pub fn tabs() -> Tabs:
    Tabs(id: zam_ui_tabs())

# 表单：左边是说明文字，右边是控件，一行一项。
pub struct Form:
    id: i64

    pub fn handle(&self) -> i64:
        self.id

    pub fn add[C: Control](&self, label: &string, child: &C, stretchy: bool = false):
        zam_ui_form_add(self.id, label, child.handle(), stretchy)

pub fn form() -> Form:
    Form(id: zam_ui_form())

# 网格：控件放在第 column 列、第 row 行（从 0 数），可以跨 width 列、height 行。
pub struct Grid:
    id: i64

    pub fn handle(&self) -> i64:
        self.id

    pub fn add[C: Control](&self, child: &C, column: i64, row: i64, width: i64 = 1, height: i64 = 1, expand: bool = false):
        zam_ui_grid_add(self.id, child.handle(), column, row, width, height, expand)

pub fn grid() -> Grid:
    Grid(id: zam_ui_grid())

# 分隔线：在 column 里用横线，在 row 里用竖线（vertical=true）。
pub struct Separator:
    id: i64

    pub fn handle(&self) -> i64:
        self.id

pub fn separator(vertical: bool = false) -> Separator:
    Separator(id: zam_ui_separator(vertical))

# ---- 文字与按钮 ----

pub struct Label:
    id: i64

    pub fn handle(&self) -> i64:
        self.id

    pub fn text(&self) -> string:
        zam_ui_label_text(self.id)

    pub fn set_text(&self, text: &string):
        zam_ui_label_set_text(self.id, text)

pub fn label(text: &string) -> Label:
    Label(id: zam_ui_label(text))

pub struct Button:
    id: i64

    pub fn handle(&self) -> i64:
        self.id

    pub fn text(&self) -> string:
        zam_ui_button_text(self.id)

    pub fn set_text(&self, text: &string):
        zam_ui_button_set_text(self.id, text)

pub fn button(text: &string) -> Button:
    Button(id: zam_ui_button(text))

# 单行输入框。
pub struct Entry:
    id: i64

    pub fn handle(&self) -> i64:
        self.id

    pub fn change_kind(&self) -> i64:
        TEXT

    pub fn text(&self) -> string:
        zam_ui_entry_text(self.id)

    pub fn set_text(&self, text: &string):
        zam_ui_entry_set_text(self.id, text)

    pub fn set_read_only(&self, on: bool):
        zam_ui_entry_set_read_only(self.id, on)

pub fn entry(text: &string = "") -> Entry:
    let e = Entry(id: zam_ui_entry(0))
    e.set_text(text)
    e

# 输入密码：显示成圆点。
pub fn password() -> Entry:
    Entry(id: zam_ui_entry(1))

# 多行文本框。wrap 为 false 时长行不折行，出现横向滚动条。
pub struct TextArea:
    id: i64

    pub fn handle(&self) -> i64:
        self.id

    pub fn change_kind(&self) -> i64:
        TEXT_AREA

    pub fn text(&self) -> string:
        zam_ui_text_area_text(self.id)

    pub fn set_text(&self, text: &string):
        zam_ui_text_area_set_text(self.id, text)

    pub fn append(&self, text: &string):
        zam_ui_text_area_append(self.id, text)

    pub fn set_read_only(&self, on: bool):
        zam_ui_text_area_set_read_only(self.id, on)

pub fn text_area(wrap: bool = true) -> TextArea:
    TextArea(id: zam_ui_text_area(wrap))

# ---- 选择 ----

pub struct Checkbox:
    id: i64

    pub fn handle(&self) -> i64:
        self.id

    pub fn change_kind(&self) -> i64:
        TOGGLE

    pub fn checked(&self) -> bool:
        zam_ui_checkbox_checked(self.id)

    pub fn set_checked(&self, on: bool):
        zam_ui_checkbox_set_checked(self.id, on)

pub fn checkbox(text: &string, checked: bool = false) -> Checkbox:
    let c = Checkbox(id: zam_ui_checkbox(text))
    c.set_checked(checked)
    c

# 滑块：取 low 到 high 之间的整数。
pub struct Slider:
    id: i64

    pub fn handle(&self) -> i64:
        self.id

    pub fn change_kind(&self) -> i64:
        SLIDE

    pub fn value(&self) -> i64:
        zam_ui_slider_value(self.id)

    pub fn set_value(&self, value: i64):
        zam_ui_slider_set_value(self.id, value)

pub fn slider(low: i64, high: i64) -> Slider:
    Slider(id: zam_ui_slider(low, high))

# 数字输入框：带上下箭头，取 low 到 high 之间的整数。
pub struct Spinbox:
    id: i64

    pub fn handle(&self) -> i64:
        self.id

    pub fn change_kind(&self) -> i64:
        SPIN

    pub fn value(&self) -> i64:
        zam_ui_spinbox_value(self.id)

    pub fn set_value(&self, value: i64):
        zam_ui_spinbox_set_value(self.id, value)

pub fn spinbox(low: i64, high: i64) -> Spinbox:
    Spinbox(id: zam_ui_spinbox(low, high))

# 进度条：0 到 100；-1 表示不确定的进度（来回滚动）。
pub struct Progress:
    id: i64

    pub fn handle(&self) -> i64:
        self.id

    pub fn value(&self) -> i64:
        zam_ui_progress_value(self.id)

    pub fn set_value(&self, value: i64):
        zam_ui_progress_set_value(self.id, value)

pub fn progress() -> Progress:
    Progress(id: zam_ui_progress())

# ---- 画布：自己画 ----
#
# ui.canvas() 是一块空白区域，画什么由你决定：app.on_draw(canvas, f) 的 f 收到一支 Painter，
# 用它画形状、渐变和文字；app.on_mouse / app.on_key 收到鼠标与键盘事件。内容要变时调用
# canvas.redraw()，界面会再调用一次 on_draw。坐标单位是像素，原点在左上角，y 向下。
# std/widgets 里的开关、按钮、图表等都是用这些画出来的，可以照着写自己的组件。

# 颜色：r、g、b、a 都在 0 到 1 之间。ui.rgb(0x3B82F6) 按十六进制写。
pub struct Color:
    r: f64
    g: f64
    b: f64
    a: f64

    # 同样的颜色，换一个不透明度。
    pub fn alpha(&self, a: f64) -> Color:
        Color(r: self.r, g: self.g, b: self.b, a: a)

    # 和 other 按 t（0 到 1）混合：t 为 0 是自己，1 是 other。做渐变动画、悬停变色时用。
    pub fn mix(&self, other: &Color, t: f64) -> Color:
        let k = max(0.0, min(1.0, t))
        Color(r: self.r + (other.r - self.r) * k, g: self.g + (other.g - self.g) * k, b: self.b + (other.b - self.b) * k, a: self.a + (other.a - self.a) * k)

    pub fn lighter(&self, t: f64) -> Color:
        self.mix(Color(r: 1.0, g: 1.0, b: 1.0, a: self.a), t)

    pub fn darker(&self, t: f64) -> Color:
        self.mix(Color(r: 0.0, g: 0.0, b: 0.0, a: self.a), t)

# 0xRRGGBB 写的颜色，不透明。
pub fn rgb(hex: i64) -> Color:
    rgba(hex, 1.0)

pub fn rgba(hex: i64, a: f64) -> Color:
    Color(r: float((hex >> 16) & 255) / 255.0, g: float((hex >> 8) & 255) / 255.0, b: float(hex & 255) / 255.0, a: a)

# 矩形区域：左上角 (x, y)，宽 w、高 h。
pub struct Rect:
    x: f64
    y: f64
    w: f64
    h: f64

    pub fn contains(&self, x: f64, y: f64) -> bool:
        x >= self.x and x < self.x + self.w and y >= self.y and y < self.y + self.h

    # 四边各收进 d（d 为负时往外扩）。
    pub fn inset(&self, d: f64) -> Rect:
        Rect(x: self.x + d, y: self.y + d, w: max(0.0, self.w - 2.0 * d), h: max(0.0, self.h - 2.0 * d))

    pub fn right(&self) -> f64:
        self.x + self.w

    pub fn bottom(&self) -> f64:
        self.y + self.h

    pub fn center_x(&self) -> f64:
        self.x + self.w / 2.0

    pub fn center_y(&self) -> f64:
        self.y + self.h / 2.0

pub fn rect(x: f64, y: f64, w: f64, h: f64) -> Rect:
    Rect(x: x, y: y, w: w, h: h)

# 文字对齐（Painter.text_in 的 align）。
pub const LEFT = 0
pub const CENTER = 1
pub const RIGHT = 2

# 画笔：只在 on_draw 的回调里有效。先用 begin、move_to、line_to、arc、add_rect 等拼路径，
# 再 fill 或 stroke；fill_rect、fill_circle、text 这些是一步画好的写法。角度是弧度，顺时针。
pub struct Painter:
    p: i64

    # 画布当前的宽和高。
    pub fn width(&self) -> f64:
        zam_ui_paint_width(self.p)

    pub fn height(&self) -> f64:
        zam_ui_paint_height(self.p)

    pub fn bounds(&self) -> Rect:
        Rect(x: 0.0, y: 0.0, w: self.width(), h: self.height())

    # ---- 路径 ----
    pub fn begin(&self):
        zam_ui_paint_begin(self.p)

    pub fn move_to(&self, x: f64, y: f64):
        zam_ui_paint_move_to(self.p, x, y)

    pub fn line_to(&self, x: f64, y: f64):
        zam_ui_paint_line_to(self.p, x, y)

    # 三次贝塞尔曲线：两个控制点，然后是终点。
    pub fn curve_to(&self, c1x: f64, c1y: f64, c2x: f64, c2y: f64, x: f64, y: f64):
        zam_ui_paint_curve_to(self.p, c1x, c1y, c2x, c2y, x, y)

    pub fn arc(&self, cx: f64, cy: f64, r: f64, start: f64, sweep: f64):
        zam_ui_paint_arc(self.p, cx, cy, r, start, sweep)

    pub fn add_rect(&self, r: &Rect):
        zam_ui_paint_rect(self.p, r.x, r.y, r.w, r.h)

    # 圆角矩形：radius 超过短边一半时按一半算。
    pub fn add_round_rect(&self, r: &Rect, radius: f64):
        let k = max(0.0, min(radius, min(r.w, r.h) / 2.0))
        let half = 1.5707963267948966
        zam_ui_paint_arc(self.p, r.x + r.w - k, r.y + k, k, -half, half)
        zam_ui_paint_arc(self.p, r.x + r.w - k, r.y + r.h - k, k, 0.0, half)
        zam_ui_paint_arc(self.p, r.x + k, r.y + r.h - k, k, half, half)
        zam_ui_paint_arc(self.p, r.x + k, r.y + k, k, 2.0 * half, half)
        zam_ui_paint_close(self.p)

    pub fn add_circle(&self, cx: f64, cy: f64, r: f64):
        zam_ui_paint_arc(self.p, cx, cy, r, 0.0, 6.283185307179586)
        zam_ui_paint_close(self.p)

    pub fn close(&self):
        zam_ui_paint_close(self.p)

    # 用颜色填满当前路径。
    pub fn fill(&self, color: &Color):
        zam_ui_paint_fill(self.p, color.r, color.g, color.b, color.a)

    # 沿当前路径描边，width 是线宽。
    pub fn stroke(&self, color: &Color, width: f64 = 1.0):
        zam_ui_paint_stroke(self.p, width, color.r, color.g, color.b, color.a)

    # 线性渐变填满当前路径：从 (x0, y0) 的 start 渐变到 (x1, y1) 的 end。
    pub fn fill_linear(&self, x0: f64, y0: f64, x1: f64, y1: f64, start: &Color, end: &Color):
        zam_ui_paint_gradient(self.p, 0, x0, y0, x1, y1, 0.0, start.r, start.g, start.b, start.a, end.r, end.g, end.b, end.a)

    # 径向渐变：圆心 (cx, cy) 是 inner，到半径 radius 处是 outer。
    pub fn fill_radial(&self, cx: f64, cy: f64, radius: f64, inner: &Color, outer: &Color):
        zam_ui_paint_gradient(self.p, 1, cx, cy, cx, cy, radius, inner.r, inner.g, inner.b, inner.a, outer.r, outer.g, outer.b, outer.a)

    # 之后只画在当前路径里面（save/restore 之间有效）。
    pub fn clip(&self):
        zam_ui_paint_clip(self.p)

    # ---- 一步画好 ----
    pub fn fill_rect(&self, r: &Rect, color: &Color):
        self.begin()
        self.add_rect(r)
        self.fill(color)

    pub fn fill_round_rect(&self, r: &Rect, radius: f64, color: &Color):
        self.begin()
        self.add_round_rect(r, radius)
        self.fill(color)

    pub fn stroke_round_rect(&self, r: &Rect, radius: f64, color: &Color, width: f64 = 1.0):
        self.begin()
        self.add_round_rect(r, radius)
        self.stroke(color, width)

    pub fn fill_circle(&self, cx: f64, cy: f64, r: f64, color: &Color):
        self.begin()
        self.add_circle(cx, cy, r)
        self.fill(color)

    pub fn stroke_circle(&self, cx: f64, cy: f64, r: f64, color: &Color, width: f64 = 1.0):
        self.begin()
        self.add_circle(cx, cy, r)
        self.stroke(color, width)

    pub fn line(&self, x1: f64, y1: f64, x2: f64, y2: f64, color: &Color, width: f64 = 1.0):
        self.begin()
        self.move_to(x1, y1)
        self.line_to(x2, y2)
        self.stroke(color, width)

    # ---- 文字（系统界面字体）----
    # 左上角在 (x, y)。
    pub fn text(&self, x: f64, y: f64, text: &string, color: &Color, size: f64 = 13.0, bold: bool = false):
        zam_ui_paint_text(self.p, x, y, text, size, bold, 0.0, 0, color.r, color.g, color.b, color.a)

    # 在矩形里排版：横向按 align（ui.LEFT、ui.CENTER、ui.RIGHT），纵向居中；太长时换行。
    pub fn text_in(&self, r: &Rect, text: &string, color: &Color, size: f64 = 13.0, bold: bool = false, align: i64 = 1):
        let h = zam_ui_text_extent(text, size, bold, r.w, 1)
        zam_ui_paint_text(self.p, r.x, r.y + (r.h - h) / 2.0, text, size, bold, r.w, align, color.r, color.g, color.b, color.a)

    # ---- 变换（save 与 restore 成对用）----
    pub fn save(&self):
        zam_ui_paint_save(self.p)

    pub fn restore(&self):
        zam_ui_paint_restore(self.p)

    pub fn translate(&self, x: f64, y: f64):
        zam_ui_paint_transform(self.p, 0, x, y)

    # 绕原点顺时针转 radians 弧度（先 translate 到中心再转，就是绕中心转）。
    pub fn rotate(&self, radians: f64):
        zam_ui_paint_transform(self.p, 1, radians, 0.0)

    pub fn scale(&self, sx: f64, sy: f64):
        zam_ui_paint_transform(self.p, 2, sx, sy)

# 文字排出来的宽和高（不用画笔，布局时用）。
pub fn text_width(text: &string, size: f64 = 13.0, bold: bool = false) -> f64:
    zam_ui_text_extent(text, size, bold, 0.0, 0)

pub fn text_height(text: &string, size: f64 = 13.0, bold: bool = false, width: f64 = 0.0) -> f64:
    zam_ui_text_extent(text, size, bold, width, 1)

# 修饰键（Mouse.modifiers()、Key.modifiers() 的各位）。
pub const CTRL = 1
pub const ALT = 2
pub const SHIFT = 4
pub const SUPER = 8

# 鼠标事件：只在 on_mouse 的回调里有效。移动时 down() 和 up() 都是 0。
pub struct Mouse:
    e: i64

    pub fn x(&self) -> f64:
        zam_ui_mouse_x(self.e)

    pub fn y(&self) -> f64:
        zam_ui_mouse_y(self.e)

    # 这次按下的键：1 左键、2 中键、3 右键；不是按下事件时是 0。
    pub fn down(&self) -> i64:
        zam_ui_mouse_down(self.e)

    # 这次松开的键，同 down。
    pub fn up(&self) -> i64:
        zam_ui_mouse_up(self.e)

    # 连击次数：双击时第二次按下是 2。
    pub fn clicks(&self) -> i64:
        zam_ui_mouse_count(self.e)

    # 移动时有没有键按着（拖动）。
    pub fn dragging(&self) -> bool:
        zam_ui_mouse_held(self.e)

    pub fn modifiers(&self) -> i64:
        zam_ui_mouse_modifiers(self.e)

# 键盘事件：只在 on_key 的回调里有效。画布要先被点一下（得到焦点）才收得到。
pub struct Key:
    e: i64

    # 可打印的键是那个字符（"a"、"1"、" "），其他是名字："Escape"、"Left"、"F1"……
    pub fn name(&self) -> string:
        zam_ui_key_name(self.e)

    pub fn released(&self) -> bool:
        zam_ui_key_up(self.e)

    pub fn modifiers(&self) -> i64:
        zam_ui_key_modifiers(self.e)

pub struct Canvas:
    id: i64
    data: i64

    pub fn handle(&self) -> i64:
        self.id

    # 让界面重画（之后会调用 on_draw）。状态变了、要更新画面时调用。
    pub fn redraw(&self):
        zam_ui_canvas_redraw(self.data)

pub fn canvas() -> Canvas:
    let data = zam_ui_canvas()
    Canvas(id: zam_ui_canvas_control(data), data: data)

# ---- 表格 ----

# 只读的文字表格：columns 是各列的标题，set_rows 整体换掉数据（每行的格数要等于列数）。
# 一次最多选中一行，selected() 是选中行的下标，没有选中时是 -1。用户选中别的行时 on_change 收到通知
# （程序自己调用 set_selected 不算）。
pub struct Table:
    id: i64
    data: i64
    columns: i64

    pub fn handle(&self) -> i64:
        self.id

    pub fn change_kind(&self) -> i64:
        SELECT

    # 换成 rows 里的数据。某一行的格数不等于列数时返回错误，表格不变。
    pub fn set_rows(&self, rows: &[[string]]) -> !string:
        for i, row in rows:
            if len(row) != self.columns:
                fail f"row {i} has {len(row)} cells, but the table has {self.columns} columns"

        zam_ui_table_set_count(self.data, len(rows))

        for i, row in rows:
            for j, cell in row:
                zam_ui_table_set_cell(self.data, i, j, cell)

            zam_ui_table_changed(self.data, i)

    pub fn selected(&self) -> i64:
        zam_ui_table_selected(self.data)

    # 选中第 row 行；-1 取消选中。
    pub fn set_selected(&self, row: i64):
        zam_ui_table_set_selected(self.data, row)

pub fn table(columns: &[string]) -> Table:
    let data = zam_ui_table(len(columns))

    for i, name in columns:
        zam_ui_table_add_column(data, name, i)

    Table(id: zam_ui_table_control(data), data: data, columns: len(columns))

# 下拉选择框，一开始选中第一项。selected() 是选中项的下标，没有选中时是 -1。
pub struct Choice:
    id: i64

    pub fn handle(&self) -> i64:
        self.id

    pub fn change_kind(&self) -> i64:
        CHOOSE

    pub fn add(&self, text: &string):
        zam_ui_choice_add(self.id, text)

    pub fn selected(&self) -> i64:
        zam_ui_choice_selected(self.id)

    pub fn set_selected(&self, index: i64):
        zam_ui_choice_set_selected(self.id, index)

pub fn choice(items: &[string]) -> Choice:
    let c = Choice(id: zam_ui_choice())

    for item in items:
        c.add(item)

    if len(items) > 0:
        c.set_selected(0)

    c

# 一组单选按钮。selected() 是选中项的下标，没有选中时是 -1。
pub struct Radio:
    id: i64

    pub fn handle(&self) -> i64:
        self.id

    pub fn change_kind(&self) -> i64:
        RADIO

    pub fn add(&self, text: &string):
        zam_ui_radio_add(self.id, text)

    pub fn selected(&self) -> i64:
        zam_ui_radio_selected(self.id)

    pub fn set_selected(&self, index: i64):
        zam_ui_radio_set_selected(self.id, index)

pub fn radio(items: &[string]) -> Radio:
    let r = Radio(id: zam_ui_radio())

    for item in items:
        r.add(item)

    r

# ---- 所有控件都能用 ----

pub fn show[C: Control](control: &C):
    zam_ui_show(control.handle())

pub fn hide[C: Control](control: &C):
    zam_ui_hide(control.handle())

pub fn set_enabled[C: Control](control: &C, on: bool):
    if on:
        zam_ui_enable(control.handle())
    else:
        zam_ui_disable(control.handle())

pub fn is_visible[C: Control](control: &C) -> bool:
    zam_ui_visible(control.handle())

pub fn is_enabled[C: Control](control: &C) -> bool:
    zam_ui_enabled(control.handle())

# ---- 程序状态与回调 ----

# 程序：把控件的事件交给回调，回调收到 &mut T（run 时交进来的状态）。
pub struct App[T]:
    handle: Option[AppHandle]

    # 点按钮时调用 handler。
    pub fn on_click(&self, button: &Button, handler: kept fn(&mut T)):
        self.connect(CLICK, button.id, handler)

    # 控件的内容变了（输入、勾选、拖动、选择）时调用 handler。
    pub fn on_change[C: Changing](&self, control: &C, handler: kept fn(&mut T)):
        self.connect(control.change_kind(), control.handle(), handler)

    # 画布需要画的时候调用 handler：第二个参数是画笔。
    pub fn on_draw(&self, canvas: &Canvas, handler: kept fn(&mut T, &Painter)):
        match self.handle:
            Some(h): _connect_event(h, DRAW, canvas.data, handler)
            None: pass

    # 鼠标在画布上移动、按下、松开时调用 handler。
    pub fn on_mouse(&self, canvas: &Canvas, handler: kept fn(&mut T, &Mouse)):
        match self.handle:
            Some(h): _connect_event(h, MOUSE, canvas.data, handler)
            None: pass

    # 画布有焦点时按键或松开时调用 handler。
    pub fn on_key(&self, canvas: &Canvas, handler: kept fn(&mut T, &Key)):
        match self.handle:
            Some(h): _connect_event(h, KEY, canvas.data, handler)
            None: pass

    # 窗口关闭之前调用 handler。
    pub fn on_close(&self, handler: kept fn(&mut T)):
        self.connect(CLOSE, 0, handler)

    # 每隔 milliseconds 毫秒调用一次 handler。
    pub fn every(&self, milliseconds: i64, handler: kept fn(&mut T)):
        self.connect(TIMER, milliseconds, handler)

    # 显示窗口，处理事件，直到窗口关闭或调用 ui.quit()。state 在此期间交给回调读写，结束后返回。
    pub fn run(&self, window: &Window, state: T) -> T:
        match self.handle:
            Some(h): return _run(h, window.id, state)
            None: pass

        state

    fn connect(&self, kind: i64, control: i64, handler: kept fn(&mut T)):
        match self.handle:
            Some(h): _connect(h, kind, control, handler)
            None: pass

# 新程序。状态的类型写在变量的标注里：let app: ui.App[Counter] = ui.app()
pub fn app[T]() -> App[T]:
    let mut handle: Option[AppHandle] = Option.None
    zam_ui_app_new(&mut handle)
    App(handle=handle)

# 结束 run 的主循环，关掉窗口。
pub fn quit():
    zam_ui_quit()

# 下面两个函数的函数体由编译器按 T 生成（见 native.rs 的 intrinsic）：它们要知道怎样把 &mut T
# 交给回调。这里的函数体只是占位。
fn _run[T](app: &AppHandle, window: i64, state: T) -> T:
    state

fn _connect[T](app: &AppHandle, kind: i64, control: i64, handler: kept fn(&mut T)):
    pass

fn _connect_event[T, E](app: &AppHandle, kind: i64, canvas: i64, handler: kept fn(&mut T, &E)):
    pass
